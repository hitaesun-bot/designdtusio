# GEMINI_API_KEY: Optional - Not used in v1 to avoid unnecessary API costs.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration (Required for live Firebase authentication, Firestore & Storage)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# Professor Emails: Comma-separated list of Google account emails granted 'professor' privileges
# Example: "hitaesun@gmail.com, professor@university.ac.kr"
# Verified server-side to prevent unauthorized privilege escalation.
PROFESSOR_EMAILS="hitaesun@gmail.com"
